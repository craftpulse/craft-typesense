{# =========================================================================
   Typesense Pro - synonyms manager (synonym editor)
   =========================================================================
   @var synonym    array|null
   @var isNew      bool
   @var editBase   string the section URL base (managed uid or config/<name>)
   @var editKey    string the post key for this collection
   @var screenName string the collection display name
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% import '_includes/forms.twig' as forms %}
{% set title = isNew ? 'New synonym'|t('typesense') : (synonym.id ?? '') %}
{% set selectedSubnavItem = 'collections' %}
{% set fullPageForm = true %}
{% set crumbs = [
    { label: 'Collections'|t('typesense'), url: url('typesense/collections') },
    { label: screenName, url: url(editBase ~ '/synonyms') },
] %}

{% block content %}
    {{ actionInput('typesense/synonyms/save-synonym') }}
    {{ hiddenInput('screenKey', editKey) }}
    {{ hiddenInput('editBase', editBase) }}

    {{ forms.textField({
        first: true,
        label: 'Synonym id'|t('typesense'),
        instructions: 'A stable identifier for this synonym.'|t('typesense'),
        id: 'id',
        name: 'id',
        value: synonym.id ?? '',
        disabled: not isNew,
        required: true,
    }) }}
    {% if not isNew %}{{ hiddenInput('id', synonym.id) }}{% endif %}

    {{ forms.textareaField({
        label: 'Terms'|t('typesense'),
        instructions: 'The interchangeable terms, one per line (or comma-separated).'|t('typesense'),
        id: 'synonyms',
        name: 'synonyms',
        value: (synonym.synonyms ?? [])|join("\n"),
        rows: 4,
        required: true,
    }) }}

    {{ forms.textField({
        label: 'Root term (one-way)'|t('typesense'),
        instructions: 'Set this to make the terms above resolve one-way to a single query. Leave blank for a multi-way synonym.'|t('typesense')
            ~ '<span class="info">'
            ~ 'With a root, a search for any term is treated as a search for the root (the terms map to it). Without a root, all terms are interchangeable both ways. Typesense stores this as the synonym’s <code>root</code>.'|t('typesense')
            ~ '</span>',
        id: 'root',
        name: 'root',
        value: synonym.root ?? '',
    }) }}

    {{ forms.languageMenuField({
        label: 'Locale'|t('typesense'),
        instructions: 'Optional language this synonym applies to.'|t('typesense')
            ~ '<span class="info">'
            ~ 'Typesense scopes a synonym to an ISO language code (for example en, nl) via its <code>locale</code>. The region is dropped on save, so en-GB is stored as en.'|t('typesense')
            ~ '</span>',
        id: 'locale',
        name: 'locale',
        value: synonym.locale ?? '',
    }) }}
{% endblock %}

{# =========================================================================
   Typesense Pro - collection edit screen: Synonyms section
   =========================================================================
   Lists a control-panel-managed collection's synonyms as a VueAdminTable
   (matching vendor/craftcms/cms/src/templates/settings/sections/_index.twig):
   the row name links to the editor, and rows delete through the core delete
   affordance. A synonym list is unbounded per collection, so the rows are paged
   server-side through a tableDataEndpoint (searchable, with the count footer).
   A collection that declares its synonyms in config is read-only with the config
   notice.

   @var editable          bool   whether this collection's synonyms are control-panel-owned
   @var editBase          string the section URL base (managed uid or config/<name>)
   @var editKey           string the post/row-id key for this collection
   @var screenName        string the collection display name
   @var navItems          array  the collection screen's permission-filtered nav
   @var tableDataEndpoint string the paged JSON page source for this collection
   ========================================================================= #}
{% extends 'typesense/collections/_layout' %}
{% set selectedNavItem = 'synonyms' %}

{# The config read-only notice rides contentNotice so the table is the sole
   content of its pane (a VueAdminTable bleeds to the pane edges and clips copy
   above it), matching core's index screens. #}
{% if not editable %}
    {% set contentNotice = 'This collection declares its synonyms in config. They are read-only here.'|t('typesense') %}
{% endif %}

{% block actionButton %}
    {% if editable %}
        <a class="btn submit add icon" href="{{ url(editBase ~ '/synonyms/new') }}">{{ 'New synonym'|t('typesense') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}
    <div id="ts-synonyms-table"></div>

    {% js %}
        var config = {
            columns: [
                { name: '__slot:title', title: Craft.t('typesense', 'Synonym') },
                { name: 'type', title: Craft.t('typesense', 'Type') },
                { name: 'terms', title: Craft.t('typesense', 'Terms') },
            ],
            container: '#ts-synonyms-table',
            emptyMessage: Craft.t('typesense', 'No synonyms yet.'),
            tableDataEndpoint: {{ tableDataEndpoint|json_encode(constant('JSON_HEX_TAG'))|raw }},
            search: true,
            pagination: true,
        };

        {% if editable %}
            config.deleteAction = 'typesense/synonyms/delete-synonym';
            config.deleteConfirmationMessage = Craft.t('typesense', 'Delete this synonym?');
        {% endif %}

        new Craft.VueAdminTable(config);
    {% endjs %}
{% endblock %}

{# =========================================================================
   Typesense Pro - synonyms manager (collection picker)
   =========================================================================
   @var collections array
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% set title = 'Synonyms'|t('typesense') %}
{% set selectedSubnavItem = 'synonyms' %}

{% block content %}
    <p class="light">{{ 'Pick a collection to manage its synonyms (one-way and multi-way).'|t('typesense') }}</p>

    {% if collections is empty %}
        <p class="light">{{ 'No collections are declared yet.'|t('typesense') }}</p>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Collection'|t('typesense') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for handle in collections %}
                    <tr>
                        <td><code>{{ handle }}</code></td>
                        <td class="thin"><a class="btn small" href="{{ url('typesense/synonyms/' ~ handle) }}">{{ 'Manage synonyms'|t('typesense') }}</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

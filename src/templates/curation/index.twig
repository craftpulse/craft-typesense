{# =========================================================================
   Typesense Pro - curation manager (collection picker)
   =========================================================================
   @var collections array
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% set title = 'Curation'|t('typesense') %}
{% set selectedSubnavItem = 'curation' %}

{% block content %}
    <p class="light">{{ 'Pick a collection to manage its curation rules (pins, hides, and boosts).'|t('typesense') }}</p>

    {% if collections is empty %}
        <div class="zilch"><p>{{ 'No collections are declared yet.'|t('typesense') }}</p></div>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Collection'|t('typesense') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for handle in collections %}
                    <tr>
                        <td><code>{{ handle }}</code></td>
                        <td class="thin"><a class="btn small" href="{{ url('typesense/curation/' ~ handle) }}">{{ 'Manage rules'|t('typesense') }}</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

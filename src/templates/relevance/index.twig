{# =========================================================================
   Typesense Pro - relevance editor (collection picker)
   =========================================================================
   @var definitions craftpulse\typesense\models\CollectionDefinition[]
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% set title = 'Relevance'|t('typesense') %}
{% set selectedSubnavItem = 'relevance' %}

{% block content %}
    <p class="light">{{ 'Tune search relevance for a control-panel-managed collection: search preset, additive boost rules, buckets, grouping, and diversification. Config-file collections tune relevance in fluent config.'|t('typesense') }}</p>

    {% if definitions is empty %}
        <p class="light">{{ 'No control-panel-managed collections yet. Create one in the collections cockpit.'|t('typesense') }}</p>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Collection'|t('typesense') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for definition in definitions %}
                    <tr>
                        <td><code>{{ definition.name }}</code></td>
                        <td class="thin"><a class="btn small" href="{{ url('typesense/relevance/' ~ definition.uid) }}">{{ 'Tune relevance'|t('typesense') }}</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

{# =========================================================================
   Typesense Pro - collection edit screen: Relevance tab
   =========================================================================
   @var definition      craftpulse\typesense\models\CollectionDefinition
   @var relevance         array
   @var supportsBuckets   bool
   @var supportsMmr       bool
   @var stopwordSetOptions array  the server stopword sets (plus none)
   @var navItems          array  the collection edit screen's permission-filtered nav
   ========================================================================= #}
{% extends 'typesense/collections/_layout' %}
{% import '_includes/forms.twig' as forms %}
{% set selectedNavItem = 'relevance' %}
{% set fullPageForm = true %}

{% set preset = relevance.searchPreset ?? {} %}
{% set boostRows = [] %}
{% for rule in relevance.boostRules ?? [] %}
    {% set condition = ((rule.conditions ?? [])|first) ?: {} %}
    {% set boostRows = boostRows|merge([{
        label: rule.label ?? '',
        field: condition.field ?? '',
        operator: condition.operator ?? 'eq',
        value: condition.value ?? '',
        weight: rule.weight ?? 0,
    }]) %}
{% endfor %}

{% block content %}
    {{ actionInput('typesense/relevance/save-relevance') }}
    {{ hiddenInput('uid', definition.uid) }}

    <p class="light">
        {{ 'Preview pending weight and preset changes before you commit them in the'|t('typesense') }}
        <a href="{{ url('typesense/playground/' ~ definition.name) }}">{{ 'search playground'|t('typesense') }}</a>{{ ' (diff mode).'|t('typesense') }}
    </p>

    <h2>{{ 'Boost rules'|t('typesense') }}</h2>
    <blockquote class="note">
        {{ 'Boost rules bake into an indexed score at index time (the deterministic alternative to _eval). Changing them requires re-syncing the collection to take effect.'|t('typesense') }}
    </blockquote>

    {{ forms.editableTableField({
        label: 'Additive boosts'|t('typesense'),
        instructions: 'Each rule adds its weight to a document’s score when its condition matches. Scores are summed, then used as the tie-breaker after text-match relevance.'|t('typesense'),
        id: 'boostRules',
        name: 'boostRules',
        cols: {
            label: { heading: 'Label'|t('typesense'), type: 'singleline' },
            field: { heading: 'Field / attribute'|t('typesense'), type: 'singleline' },
            operator: { heading: 'Operator'|t('typesense'), type: 'select', options: [
                { label: 'equals'|t('typesense'), value: 'eq' },
                { label: 'not equals'|t('typesense'), value: 'ne' },
                { label: 'contains'|t('typesense'), value: 'contains' },
                { label: 'greater than'|t('typesense'), value: 'gt' },
                { label: 'less than'|t('typesense'), value: 'lt' },
                { label: 'is not empty'|t('typesense'), value: 'notEmpty' },
                { label: 'is empty'|t('typesense'), value: 'empty' },
            ] },
            value: { heading: 'Value'|t('typesense'), type: 'singleline' },
            weight: { heading: 'Weight'|t('typesense'), type: 'number' },
        },
        rows: boostRows,
        addRowLabel: 'Add a boost'|t('typesense'),
    }) }}

    <hr>

    <h2>{{ 'Search defaults'|t('typesense') }}</h2>
    <p class="light">{{ 'These defaults are passed with every search against this collection. Leave a field blank to use the server default.'|t('typesense') }}</p>

    {{ forms.textField({
        label: 'Typo tolerance'|t('typesense'),
        instructions: 'How many typos a match may contain (0, 1, or 2).'|t('typesense')
            ~ '<span class="info">'
            ~ 'The maximum number of typographical errors (Damerau-Levenshtein distance) tolerated per word. Typesense search parameter <code>num_typos</code>.'|t('typesense')
            ~ '</span>',
        id: 'num_typos', name: 'num_typos', value: preset.num_typos ?? '', size: 6,
    }) }}
    {{ forms.textField({
        label: 'Prefix matching'|t('typesense'),
        instructions: 'Whether the last word is matched as a prefix (for autocomplete).'|t('typesense')
            ~ '<span class="info">'
            ~ 'Treats the last query word as a prefix, not a whole word, which powers instant-search and autocomplete. Set to false to disable, or give a comma-separated per-field list. Typesense search parameter <code>prefix</code>.'|t('typesense')
            ~ '</span>',
        id: 'prefix', name: 'prefix', value: preset.prefix ?? '',
    }) }}
    {{ forms.textField({
        label: 'Drop-tokens threshold'|t('typesense'),
        instructions: 'When to start dropping query words to find enough results.'|t('typesense')
            ~ '<span class="info">'
            ~ 'If fewer than this many results contain all query words, Typesense drops words (from the right) and retries, broadening a multi-word query. Typesense search parameter <code>drop_tokens_threshold</code>.'|t('typesense')
            ~ '</span>',
        id: 'drop_tokens_threshold', name: 'drop_tokens_threshold', value: preset.drop_tokens_threshold ?? '', size: 6,
    }) }}
    {{ forms.textField({
        label: 'Typo-correction threshold'|t('typesense'),
        instructions: 'When to start looking for typo-corrected variations.'|t('typesense')
            ~ '<span class="info">'
            ~ 'If fewer than this many results are found for a term, Typesense looks for typo-corrected variations until it reaches the threshold. Typesense search parameter <code>typo_tokens_threshold</code>.'|t('typesense')
            ~ '</span>',
        id: 'typo_tokens_threshold', name: 'typo_tokens_threshold', value: preset.typo_tokens_threshold ?? '', size: 6,
    }) }}
    {{ forms.textField({
        label: 'Min length for 1 typo'|t('typesense'),
        instructions: 'Shortest word that may be matched with one typo (default 4).'|t('typesense')
            ~ '<span class="info">'
            ~ 'The minimum word length before a single-typo correction applies; shorter words must match exactly. Typesense search parameter <code>min_len_1typo</code>.'|t('typesense')
            ~ '</span>',
        id: 'min_len_1typo', name: 'min_len_1typo', value: preset.min_len_1typo ?? '', size: 6,
    }) }}
    {{ forms.textField({
        label: 'Min length for 2 typos'|t('typesense'),
        instructions: 'Shortest word that may be matched with two typos (default 7).'|t('typesense')
            ~ '<span class="info">'
            ~ 'The minimum word length before a two-typo correction applies. Typesense search parameter <code>min_len_2typo</code>.'|t('typesense')
            ~ '</span>',
        id: 'min_len_2typo', name: 'min_len_2typo', value: preset.min_len_2typo ?? '', size: 6,
    }) }}

    {{ forms.selectField({
        label: 'Stopword set'|t('typesense'),
        instructions: 'A server stopword set whose words are dropped from every query against this collection.'|t('typesense')
            ~ '<span class="info">'
            ~ 'Applied as the default <code>stopwords</code> search parameter (via the collection’s preset). Stopword sets are server-global; manage them under Typesense, then Dictionaries.'|t('typesense')
            ~ '</span>',
        id: 'stopwordSet',
        name: 'stopwordSet',
        options: stopwordSetOptions,
        value: preset.stopwords ?? '',
    }) }}

    <hr>

    <h2>{{ 'Result grouping'|t('typesense') }}</h2>

    {{ forms.textField({
        label: 'Group by field'|t('typesense'),
        instructions: 'Collapse results sharing this field value (for example variant collapse). Leave blank to disable.'|t('typesense'),
        id: 'groupBy',
        name: 'groupBy',
        value: relevance.grouping.field ?? '',
    }) }}

    {{ forms.textField({
        label: 'Group limit'|t('typesense'),
        type: 'number',
        id: 'groupLimit',
        name: 'groupLimit',
        value: relevance.grouping.limit ?? 1,
        size: 6,
    }) }}

    {% if supportsBuckets %}
        <hr>
        <h2>{{ 'Text-match buckets'|t('typesense') }}</h2>
        {{ forms.textField({
            label: 'Buckets'|t('typesense'),
            instructions: 'Bucket text-match scores into N tiers so secondary sorts (boosts) can reorder within a tier. 0 disables bucketing.'|t('typesense'),
            type: 'number',
            id: 'textMatchBuckets',
            name: 'textMatchBuckets',
            value: relevance.textMatchBuckets ?? 0,
            size: 6,
        }) }}
    {% endif %}

    {% if supportsMmr %}
        <hr>
        <h2>{{ 'Diversification (MMR)'|t('typesense') }}</h2>
        {{ forms.lightswitchField({
            label: 'Enable MMR'|t('typesense'),
            instructions: 'Maximal Marginal Relevance diversifies results (requires vector search).'|t('typesense'),
            id: 'mmrEnabled',
            name: 'mmrEnabled',
            on: relevance.mmr.enabled ?? false,
        }) }}
        {{ forms.textField({
            label: 'Lambda'|t('typesense'),
            instructions: '0 to 1: higher favours relevance, lower favours diversity.'|t('typesense'),
            id: 'mmrLambda',
            name: 'mmrLambda',
            value: relevance.mmr.lambda ?? 0.5,
            size: 6,
        }) }}
    {% endif %}
{% endblock %}

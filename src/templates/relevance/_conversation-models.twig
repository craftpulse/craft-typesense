{# =========================================================================
   Typesense Pro - conversation (RAG) model management
   =========================================================================
   @var definition craftpulse\typesense\models\CollectionDefinition
   @var models     array
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% import '_includes/forms.twig' as forms %}
{% set title = 'Conversation models'|t('typesense') %}
{% set selectedSubnavItem = 'collections' %}
{% set crumbs = [
    { label: 'Collections'|t('typesense'), url: url('typesense/collections') },
    { label: definition.name, url: url('typesense/collections/' ~ definition.uid ~ '/vector') },
] %}

{% block content %}
    <blockquote class="note warning">
        {{ 'Conversational RAG makes a per-search call to an LLM provider, so each conversational query has a cost. The API key is read from an environment variable and never stored by the plugin.'|t('typesense') }}
    </blockquote>

    <h2>{{ 'Models'|t('typesense') }}</h2>

    {% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}
    <div id="ts-conversation-models-table"></div>

    {% set tableData = [] %}
    {% for model in models %}
        {% set tableData = tableData|merge([{
            id: model.id,
            handle: model.id,
            modelName: model.model_name ?? '',
            historyCollection: model.history_collection ?? '',
        }]) %}
    {% endfor %}

    {% js %}
        new Craft.VueAdminTable({
            columns: [
                { name: '__slot:handle', title: Craft.t('typesense', 'ID') },
                { name: 'modelName', title: Craft.t('typesense', 'Model') },
                { name: 'historyCollection', title: Craft.t('typesense', 'History collection') },
            ],
            container: '#ts-conversation-models-table',
            emptyMessage: Craft.t('typesense', 'No conversation models yet.'),
            tableData: {{ tableData|json_encode(constant('JSON_HEX_TAG'))|raw }},
            deleteAction: 'typesense/relevance/delete-conversation-model',
            deleteConfirmationMessage: Craft.t('typesense', 'Delete this conversation model?'),
        });
    {% endjs %}

    <hr>
    <h2>{{ 'Add a model'|t('typesense') }}</h2>
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('typesense/relevance/save-conversation-model') }}
        {{ forms.textField({ first: true, label: 'ID'|t('typesense'), name: 'id', class: 'code', required: true }) }}
        {{ forms.textField({ label: 'Model name'|t('typesense'), instructions: 'For example openai/gpt-4o-mini.'|t('typesense'), name: 'model_name', required: true }) }}
        {{ forms.textField({ label: 'API key (env reference)'|t('typesense'), instructions: 'Enter the environment reference, for example $OPENAI_API_KEY, never the raw key.'|t('typesense'), name: 'api_key', required: true }) }}
        {{ forms.textField({ label: 'History collection'|t('typesense'), instructions: 'Created automatically if it does not exist.'|t('typesense'), name: 'history_collection', value: 'conversation_store', required: true }) }}
        {{ forms.textareaField({ label: 'System prompt'|t('typesense'), name: 'system_prompt', rows: 3 }) }}
        <div class="buttons"><button type="submit" class="btn submit">{{ 'Create'|t('typesense') }}</button></div>
    </form>
{% endblock %}

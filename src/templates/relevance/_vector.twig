{# =========================================================================
   Typesense Pro - collection edit screen: Vector / AI section
   =========================================================================
   Two anchor panes in one form (a single Save persists both): Embedding (the
   auto-embedding config, built-in or a referenced embedding provider) and
   Conversation (the conversational ask opt-in, a referenced conversation model
   instance). Follows the anchor-tab pattern in the craftcms skill's cp.md.

   @var definition          craftpulse\typesense\models\CollectionDefinition
   @var embedding           array
   @var conversation        array
   @var builtinOptions      array  built-in model select options
   @var providerOptions     array  embedding-kind provider select options
   @var conversationOptions array  conversation model instance select options
   @var navItems            array  the collection edit screen's permission-filtered nav
   ========================================================================= #}
{% extends 'typesense/collections/_layout' %}
{% import '_includes/forms.twig' as forms %}
{% set selectedNavItem = 'vector' %}
{% set fullPageForm = true %}

{% set tabs = {
    tsEmbedding: { label: 'Embedding'|t('typesense'), url: '#ts-embedding' },
    tsConversation: { label: 'Conversation'|t('typesense'), url: '#ts-conversation' },
} %}

{% set isProvider = (embedding.builtIn ?? true) == false %}

{% block content %}
    {{ actionInput('typesense/relevance/save-vector') }}
    {{ hiddenInput('uid', definition.uid) }}

    <div id="ts-embedding">
        <blockquote class="note">
            {{ 'Auto-embedding generates vectors server-side at index time, powering semantic and hybrid search. Changing the model or source fields re-embeds every document: re-sync the collection after saving. Built-in ts/* models run on the server CPU (no key); a provider makes an API call per document at index time (cost).'|t('typesense') }}
        </blockquote>

        {{ forms.lightswitchField({
            label: 'Enable auto-embedding'|t('typesense'),
            id: 'embedEnabled',
            name: 'embedEnabled',
            on: embedding.enabled ?? false,
        }) }}

        {{ forms.selectField({
            label: 'Model source'|t('typesense'),
            instructions: 'A built-in local model, or a remote model served by an AI provider.'|t('typesense'),
            id: 'embedBranch',
            name: 'embedBranch',
            options: [
                { label: 'Built-in model'|t('typesense'), value: 'builtin' },
                { label: 'Provider model'|t('typesense'), value: 'provider' },
            ],
            value: isProvider ? 'provider' : 'builtin',
            toggle: true,
            targetPrefix: 'embed-branch-',
        }) }}

        <div id="embed-branch-builtin"{% if isProvider %} class="hidden"{% endif %}>
            {{ forms.selectField({
                label: 'Built-in model'|t('typesense'),
                instructions: 'A local ONNX model (no API key). CLIP embeds images (use the asset image field as the source).'|t('typesense'),
                id: 'embedBuiltinModel',
                name: 'embedBuiltinModel',
                options: builtinOptions,
                value: not isProvider ? (embedding.model ?? '') : '',
            }) }}
        </div>

        <div id="embed-branch-provider"{% if not isProvider %} class="hidden"{% endif %}>
            {{ forms.selectField({
                label: 'Embedding provider'|t('typesense'),
                instructions: 'The AI provider supplying the credentials and endpoint. Create one on the AI providers screen first.'|t('typesense'),
                id: 'embedProvider',
                name: 'embedProvider',
                options: providerOptions,
                value: embedding.providerHandle ?? '',
            }) }}

            {{ forms.autosuggestField({
                label: 'Model name'|t('typesense'),
                instructions: 'The remote model name Typesense expects, for example openai/text-embedding-3-small.'|t('typesense'),
                id: 'embedModelName',
                name: 'embedModelName',
                class: 'code',
                value: isProvider ? (embedding.model ?? '') : '',
                placeholder: 'openai/text-embedding-3-small',
            }) }}

            {{ forms.textField({
                label: 'Output dimensions'|t('typesense'),
                instructions: 'The vector size the remote model outputs (for example 1536 for text-embedding-3-small).'|t('typesense'),
                type: 'number',
                id: 'embedDims',
                name: 'embedDims',
                value: embedding.dims ?? '',
                size: 8,
            }) }}
        </div>

        {{ forms.textareaField({
            label: 'Source fields'|t('typesense'),
            instructions: 'The document field handles to embed, one per line (or comma-separated). For CLIP image search, use the asset image field.'|t('typesense'),
            id: 'embedFrom',
            name: 'embedFrom',
            value: (embedding.from ?? [])|join("\n"),
            rows: 3,
        }) }}

        {{ forms.textField({
            label: 'Indexing prefix'|t('typesense'),
            instructions: 'Optional prefix prepended to documents before embedding (some models, for example E5, expect one).'|t('typesense'),
            id: 'embedIndexingPrefix',
            name: 'embedIndexingPrefix',
            value: embedding.indexingPrefix ?? '',
        }) }}

        {{ forms.textField({
            label: 'Query prefix'|t('typesense'),
            instructions: 'Optional prefix prepended to the query before embedding.'|t('typesense'),
            id: 'embedQueryPrefix',
            name: 'embedQueryPrefix',
            value: embedding.queryPrefix ?? '',
        }) }}
    </div>

    <div id="ts-conversation" class="hidden">
        <blockquote class="note warning">
            {{ 'Conversational ask answers free-form questions from this collection with an LLM. Every question is a paid model call, so opt in deliberately and set your abuse policy at the edge (a CDN or WAF rate rule). The endpoint is off unless a model is chosen here and pushed to the server.'|t('typesense') }}
        </blockquote>

        {{ forms.lightswitchField({
            label: 'Enable conversational ask'|t('typesense'),
            id: 'askEnabled',
            name: 'askEnabled',
            on: conversation.enabled ?? false,
        }) }}

        {{ forms.selectField({
            label: 'Conversation model'|t('typesense'),
            instructions: 'The conversation model instance this collection answers with. Authored on the AI providers screen.'|t('typesense'),
            id: 'askModel',
            name: 'askModel',
            options: conversationOptions,
            value: conversation.modelHandle ?? '',
        }) }}

        <p><a class="go" href="{{ url('typesense/ai-providers') }}">{{ 'Manage AI providers and conversation models'|t('typesense') }}</a></p>
    </div>
{% endblock %}

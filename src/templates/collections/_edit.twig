{# =========================================================================
   Typesense Pro - Collections cockpit (create/edit)
   =========================================================================
   The Settings section of a control-panel-managed collection's edit screen. A
   new (unsaved) collection is a single-pane form; once saved, it becomes the
   Settings section of the shared collection edit layout (Mapping, Relevance, and
   Vector / AI sections join it from the inner-sidebar nav). Persists to project
   config via typesense/collections/save.

   @var definition    CollectionDefinition
   @var sourceOptions array
   @var isNew         bool
   @var navItems      array  the collection edit screen's permission-filtered nav
   ========================================================================= #}
{% extends isNew ? '_layouts/cp' : 'typesense/collections/_layout' %}
{% import '_includes/forms.twig' as forms %}

{% if isNew %}
    {% set title = 'New collection'|t('typesense') %}
    {% set selectedSubnavItem = 'collections' %}
    {% set crumbs = [
        { label: 'Collections'|t('typesense'), url: url('typesense/collections') },
    ] %}
{% else %}
    {% set selectedNavItem = 'settings' %}
{% endif %}
{% set fullPageForm = true %}

{% block content %}
    {{ actionInput('typesense/collections/save') }}
    {% if not isNew %}{{ hiddenInput('uid', definition.uid) }}{% endif %}

    {{ forms.textField({
        first: true,
        label: 'Name'|t('typesense'),
        instructions: 'A friendly label for this collection, shown throughout the control panel. Editable any time.'|t('typesense'),
        id: 'name',
        name: 'displayName',
        value: definition.displayName,
        required: true,
        errors: definition.getErrors('displayName'),
    }) }}

    {{ forms.textField({
        label: 'Index name'|t('typesense'),
        instructions: 'The Typesense collection (index) name your front end queries. Letters, numbers, underscores, and hyphens. Locked once the collection is created.'|t('typesense'),
        id: 'handle',
        name: 'name',
        class: 'code',
        value: definition.name,
        disabled: not isNew,
        required: true,
        errors: definition.getErrors('name'),
    }) }}

    {% if isNew %}
        {% js %}new Craft.HandleGenerator('#name', '#handle');{% endjs %}
    {% endif %}

    {{ forms.selectField({
        label: 'Element source'|t('typesense'),
        instructions: 'The element type and source this collection indexes.'|t('typesense'),
        id: 'source',
        name: 'source',
        options: sourceOptions,
        value: definition.elementType ~ ':' ~ (definition.sourceType == 'entryType' ? 'type:' : '') ~ (definition.source ?? ''),
    }) }}

    {{ forms.selectField({
        label: 'Multisite strategy'|t('typesense'),
        instructions: 'How this collection maps to Craft sites.'|t('typesense'),
        id: 'multisite',
        name: 'multisite',
        options: [
            { label: 'Shared, filtered by site'|t('typesense'), value: 'sharedWithSiteFilter' },
            { label: 'One collection per site'|t('typesense'), value: 'collectionPerSite' },
        ],
        value: definition.multisite,
    }) }}

    {{ forms.lightswitchField({
        label: 'Enabled'|t('typesense'),
        instructions: 'Whether this collection syncs.'|t('typesense'),
        id: 'enabled',
        name: 'enabled',
        on: definition.enabled,
    }) }}

    {% if isNew %}
        <p class="light">{{ 'Save the collection, then map its fields and tune relevance from the tabs that appear.'|t('typesense') }}</p>
    {% endif %}
{% endblock %}

{% block details %}
    {% if not isNew %}
        <div class="meta">
            {{ forms.lightswitchField({
                label: 'Suspend sync'|t('typesense'),
                instructions: globallySuspended
                    ? 'Sync is globally suspended in the utility.'|t('typesense')
                    : 'Pause automatic indexing for this collection (for bulk imports). Runtime state, not project config.'|t('typesense'),
                id: 'ts-suspend',
                name: 'suspendState',
                on: suspended,
                disabled: globallySuspended,
            }) }}
        </div>

        {% js %}
            (function() {
                var $sw = $('#ts-suspend');
                $sw.on('change', function() {
                    var on = $(this).hasClass('on');
                    Craft.sendActionRequest('POST', 'typesense/collections/toggle-suspend', {
                        data: { collection: {{ definition.name|json_encode|raw }} }
                    }).then(function() {
                        Craft.cp.displayNotice(Craft.t('typesense', on ? 'Sync suspended.' : 'Sync resumed.'));
                    }).catch(function() {
                        Craft.cp.displayError(Craft.t('typesense', 'Could not update sync state.'));
                    });
                });
            })();
        {% endjs %}
    {% endif %}
{% endblock %}

{# =========================================================================
   Typesense Pro - Collections cockpit (browse)
   =========================================================================
   Lists the control-panel-managed collections (create/edit/delete) and, read
   only, the collections owned by config/typesense.php. Each list is a
   VueAdminTable (matching vendor/craftcms/cms/src/templates/settings/assets/
   transforms/_index.twig): row name links to the collection edit screen, and
   the managed table deletes through the core delete affordance. A config-owned
   collection that displaces a code-registered one carries the "overridden by
   the config file" notice.

   The two tables are split across anchor tabs rather than stacked under
   headings: a VueAdminTable's pane bleeds with negative margins and is designed
   to be the sole content of a pane (core never stacks two under headings), so
   stacking them clipped the headings. Each tab pane holds one table as its sole
   content, following the anchor-tab pattern in the craftcms skill's cp.md (tab
   key, `url: '#...'` anchor, and the matching pane `<div id>` all line up, with
   feature-prefixed keys so they never collide with Craft's reserved DOM ids).

   Each row carries a copyable "Typesense collection" chip: the exact name a
   front end should query (the logical/alias name when the collection sits behind
   an alias, the physical name otherwise), so someone rolling their own front end
   can copy it and query Typesense directly. It rides the VueAdminTable handle
   slot, which renders Craft's copy-text button.

   The second tab is "Code managed": the read-only, code-owned sources
   (config-file declarations and module/event registrations), never the merged
   runtime map, so a control-panel-managed collection never leaks in with a false
   config-owned status. A Source column distinguishes config file from module.

   @var managed              array   uid => CollectionDefinition (CP-managed)
   @var managedTsNames       array   uid  => the query-correct Typesense name
   @var codeCollections      array   name => {name, tsName, elementType, source, overridden}
   @var canManageCollections bool    whether the viewer may create/edit/delete
   @var rowSectionSuffix     string  the section suffix the viewer first reaches
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% set title = 'Collections'|t('typesense') %}
{% set selectedSubnavItem = 'collections' %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}

{% set tabs = {
    tsCpManaged: { label: 'CP managed'|t('typesense'), url: '#ts-cp-managed' },
    tsConfigManaged: { label: 'Code managed'|t('typesense'), url: '#ts-config-managed' },
} %}

{% block actionButton %}
    {% if canManageCollections %}
        <a href="{{ url('typesense/collections/new') }}" class="btn submit add icon">{{ 'New collection'|t('typesense') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div id="ts-cp-managed">
        <div id="ts-managed-collections-table"></div>
    </div>

    <div id="ts-config-managed" class="hidden">
        <div id="ts-config-collections-table"></div>
    </div>

    {% set managedData = [] %}
    {% for uid, def in managed %}
        {% set managedData = managedData|merge([{
            id: uid,
            title: def.displayName,
            url: url('typesense/collections/' ~ uid ~ rowSectionSuffix),
            handle: managedTsNames[uid] ?? def.name,
            elementType: def.elementType|split('\\')|last,
            source: def.source ?? 'All'|t('typesense'),
            enabled: def.enabled,
        }]) %}
    {% endfor %}

    {% set codeData = [] %}
    {% for row in codeCollections %}
        {% set codeData = codeData|merge([{
            title: row.name,
            url: url('typesense/collections/config/' ~ row.name),
            handle: row.tsName,
            elementType: row.elementType|split('\\')|last,
            sourceLabel: row.source == 'module' ? 'Module'|t('typesense') : 'Config file'|t('typesense'),
            status: row.overridden ? 'Overridden by the config file'|t('typesense') : 'Read only'|t('typesense'),
        }]) %}
    {% endfor %}

    {% js %}
        var managedConfig = {
            columns: [
                { name: '__slot:title', title: Craft.t('typesense', 'Name') },
                { name: '__slot:handle', title: Craft.t('typesense', 'Typesense collection') },
                { name: 'elementType', title: Craft.t('typesense', 'Element type') },
                { name: 'source', title: Craft.t('typesense', 'Source') },
                {
                    name: 'enabled',
                    title: Craft.t('typesense', 'Enabled'),
                    callback: function(value) {
                        return '<span class="status ' + (value ? 'green' : '') + '"></span>' +
                            (value ? Craft.t('typesense', 'Enabled') : Craft.t('typesense', 'Disabled'));
                    },
                },
            ],
            container: '#ts-managed-collections-table',
            emptyMessage: Craft.t('typesense', 'No control-panel collections yet. Create one to map an element source to a Typesense collection.'),
            tableData: {{ managedData|json_encode(constant('JSON_HEX_TAG'))|raw }},
        };

        {% if canManageCollections %}
            managedConfig.deleteAction = 'typesense/collections/delete';
            managedConfig.deleteConfirmationMessage = Craft.t('typesense', 'Delete this collection? Its Typesense collection and mapping are removed.');
        {% endif %}

        new Craft.VueAdminTable(managedConfig);

        new Craft.VueAdminTable({
            columns: [
                { name: '__slot:title', title: Craft.t('typesense', 'Name') },
                { name: '__slot:handle', title: Craft.t('typesense', 'Typesense collection') },
                { name: 'elementType', title: Craft.t('typesense', 'Element type') },
                { name: 'sourceLabel', title: Craft.t('typesense', 'Source') },
                { name: 'status', title: Craft.t('typesense', 'Status') },
            ],
            container: '#ts-config-collections-table',
            emptyMessage: Craft.t('typesense', 'No config-file or module-registered collections.'),
            tableData: {{ codeData|json_encode(constant('JSON_HEX_TAG'))|raw }},
        });
    {% endjs %}
{% endblock %}

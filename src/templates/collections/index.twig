{# =========================================================================
   Typesense Pro - Collections cockpit (browse)
   =========================================================================
   Lists the control-panel-managed collections (create/edit/delete) and, read
   only below, the collections owned by config/typesense.php. A config-owned
   collection that displaces a code-registered one carries the "overridden by
   the config file" notice.

   @var managed           array
   @var configCollections array
   @var overriddenNames   array
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% set title = 'Collections'|t('typesense') %}
{% set selectedSubnavItem = 'collections' %}

{% block actionButton %}
    <a href="{{ url('typesense/collections/new') }}" class="btn submit add icon">{{ 'New collection'|t('typesense') }}</a>
{% endblock %}

{% block content %}
    <h2>{{ 'Managed in the control panel'|t('typesense') }}</h2>
    {% if managed is empty %}
        <p class="light">{{ 'No control-panel collections yet. Create one to map an element source to a Typesense collection.'|t('typesense') }}</p>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Name'|t('typesense') }}</th>
                    <th>{{ 'Element type'|t('typesense') }}</th>
                    <th>{{ 'Source'|t('typesense') }}</th>
                    <th>{{ 'Enabled'|t('typesense') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for uid, def in managed %}
                    <tr>
                        <td><a href="{{ url('typesense/collections/' ~ uid) }}"><code>{{ def.name }}</code></a></td>
                        <td>{{ def.elementType|split('\\')|last }}</td>
                        <td>{{ def.source ?? 'All'|t('typesense') }}</td>
                        <td>
                            {% if def.enabled %}
                                <span class="status green"></span> {{ 'Yes'|t('typesense') }}
                            {% else %}
                                <span class="status"></span> {{ 'No'|t('typesense') }}
                            {% endif %}
                        </td>
                        <td class="thin">
                            <form method="post" accept-charset="UTF-8">
                                {{ csrfInput() }}
                                {{ actionInput('typesense/collections/delete') }}
                                {{ hiddenInput('uid', uid) }}
                                <button type="submit" class="btn small delete icon" title="{{ 'Delete'|t('typesense') }}"></button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <hr>

    <h2>{{ 'Managed in config'|t('typesense') }}</h2>
    {% if configCollections is empty %}
        <p class="light">{{ 'No config-file collections are declared.'|t('typesense') }}</p>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Name'|t('typesense') }}</th>
                    <th>{{ 'Element type'|t('typesense') }}</th>
                    <th>{{ 'Status'|t('typesense') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for name, collection in configCollections %}
                    <tr>
                        <td><code>{{ name }}</code></td>
                        <td>{{ collection.getElementType()|split('\\')|last }}</td>
                        <td>
                            {% if name in overriddenNames %}
                                <span class="status orange"></span>
                                {{ 'Overridden by the config file'|t('typesense') }}
                            {% else %}
                                <span class="light">{{ 'Read only (config-owned)'|t('typesense') }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

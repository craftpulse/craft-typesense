{# =========================================================================
   Typesense Pro - A/B experiments
   =========================================================================
   @var experiments craftpulse\typesense\models\Experiment[]
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% set title = 'A/B experiments'|t('typesense') %}
{% set selectedSubnavItem = 'experiments' %}

{% block actionButton %}
    <a class="btn submit add icon" href="{{ url('typesense/experiments/new') }}">{{ 'New experiment'|t('typesense') }}</a>
{% endblock %}

{% block content %}
    <p class="light">{{ 'An A/B experiment splits a collection’s search traffic between variants. Each variant applies its own search composition (a preset, an optional scoped-key filter profile, and an analytics tag), and the front end asks craft.typesense.experiment("handle") which variant to use per visitor. Compare the tagged results in the analytics dashboard.'|t('typesense') }}</p>

    {% if experiments is empty %}
        <div class="zilch">
            <p>{{ 'No experiments yet.'|t('typesense') }}</p>
            <p class="light">{{ 'An experiment serves weighted search variants for one collection and attributes analytics per variant, so you can measure which composition performs better. You need a collection first; scoped-key profiles are optional. Create one to define its variants.'|t('typesense') }}</p>
            <a class="btn submit add icon" href="{{ url('typesense/experiments/new') }}">{{ 'New experiment'|t('typesense') }}</a>
        </div>
    {% else %}
    {% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}
    <div id="ts-experiments-table"></div>

    {% set tableData = [] %}
    {% for handle, experiment in experiments %}
        {% set tableData = tableData|merge([{
            id: handle,
            title: experiment.name,
            url: url('typesense/experiments/' ~ handle),
            handle: handle,
            collection: experiment.collection,
            variants: experiment.variants|length,
            status: experiment.enabled ? 'Active'|t('typesense') : 'Paused'|t('typesense'),
        }]) %}
    {% endfor %}

    {% js %}
        new Craft.VueAdminTable({
            columns: [
                { name: '__slot:title', title: Craft.t('typesense', 'Experiment') },
                { name: '__slot:handle', title: Craft.t('typesense', 'Handle') },
                { name: 'collection', title: Craft.t('typesense', 'Collection') },
                { name: 'variants', title: Craft.t('typesense', 'Variants') },
                { name: 'status', title: Craft.t('typesense', 'Status') },
            ],
            container: '#ts-experiments-table',
            emptyMessage: Craft.t('typesense', 'No experiments yet.'),
            tableData: {{ tableData|json_encode(constant('JSON_HEX_TAG'))|raw }},
            deleteAction: 'typesense/experiments/delete',
            deleteConfirmationMessage: Craft.t('typesense', 'Delete this experiment?'),
        });
    {% endjs %}
    {% endif %}
{% endblock %}

{# =========================================================================
   Typesense Pro - A/B experiment editor
   =========================================================================
   @var experiment  craftpulse\typesense\models\Experiment
   @var isNew       bool
   @var collections string[]
   @var profiles    string[]  scoped-key profile handles
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% import '_includes/forms.twig' as forms %}
{% set title = isNew ? 'New experiment'|t('typesense') : experiment.name %}
{% set selectedSubnavItem = 'experiments' %}
{% set fullPageForm = true %}
{% set crumbs = [{ label: 'A/B experiments'|t('typesense'), url: url('typesense/experiments') }] %}

{% set profileOptions = [{ label: '(none)'|t('typesense'), value: '' }]|merge(profiles|map(p => { label: p, value: p })) %}

{% block content %}
    <div class="readable">
        <blockquote class="note">
            {{ 'An experiment defines weighted variants for one collection. Once active, your front end calls craft.typesense.experiment("handle") to get a variant for the visitor, applies that variant’s composition to the search, and the variant’s analytics tag lets the analytics dashboard compare them. Saving does not change any search on its own: nothing runs until your templates call the helper.'|t('typesense') }}
        </blockquote>
    </div>

    {{ actionInput('typesense/experiments/save') }}
    {% if not isNew %}{{ hiddenInput('originalHandle', experiment.handle) }}{% endif %}

    {{ forms.textField({
        first: true,
        label: 'Name'|t('typesense'),
        instructions: 'A label for this experiment (for example, Homepage relevance test).'|t('typesense'),
        id: 'name',
        name: 'name',
        value: experiment.name,
        required: true,
    }) }}

    {{ forms.textField({
        label: 'Handle'|t('typesense'),
        instructions: 'The identifier your templates pass to craft.typesense.experiment("handle").'|t('typesense'),
        id: 'handle',
        name: 'handle',
        class: 'code',
        value: experiment.handle,
        disabled: not isNew,
        required: true,
    }) }}

    {% if isNew %}
        {% js %}new Craft.HandleGenerator('#name', '#handle');{% endjs %}
    {% endif %}

    {{ forms.selectField({
        label: 'Collection'|t('typesense'),
        instructions: 'The collection whose searches this experiment splits.'|t('typesense'),
        id: 'collection',
        name: 'collection',
        options: collections|map(c => { label: c, value: c }),
        value: experiment.collection,
    }) }}

    {{ forms.lightswitchField({
        label: 'Active'|t('typesense'),
        instructions: 'When off, craft.typesense.experiment("handle") returns nothing and your templates fall back to a normal search.'|t('typesense'),
        id: 'enabled',
        name: 'enabled',
        on: experiment.enabled,
    }) }}

    {{ forms.editableTableField({
        label: 'Variants'|t('typesense'),
        instructions: 'Each variant is served to a weighted share of traffic. The analytics tag attributes results to the variant (requires an analytics-capable server).'|t('typesense'),
        id: 'variants',
        name: 'variants',
        cols: {
            handle: { heading: 'Handle'|t('typesense'), type: 'singleline', info: 'A stable identifier for this variant.'|t('typesense') },
            name: { heading: 'Name'|t('typesense'), type: 'singleline' },
            weight: { heading: 'Weight'|t('typesense'), type: 'number', info: 'The variant’s share of traffic, relative to the other variants’ weights.'|t('typesense') },
            profile: { heading: 'Scoped-key profile'|t('typesense'), type: 'select', options: profileOptions, info: 'An optional scoped-key profile whose filter this variant applies.'|t('typesense') },
            preset: { heading: 'Preset'|t('typesense'), type: 'singleline', info: 'An optional Typesense search preset name applied for this variant (the preset search parameter).'|t('typesense') },
            analyticsTag: { heading: 'Analytics tag'|t('typesense'), type: 'singleline', info: 'A tag attached to this variant’s searches so results are attributed to it (needs an analytics-capable server).'|t('typesense') },
        },
        rows: experiment.variants,
        addRowLabel: 'Add a variant'|t('typesense'),
    }) }}
{% endblock %}

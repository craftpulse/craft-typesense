{# =========================================================================
   Typesense Pro - API keys manager
   =========================================================================
   @var keys     array  server keys (value prefixes only)
   @var profiles craftpulse\typesense\models\KeyProfile[]
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% set title = 'API keys'|t('typesense') %}
{% set selectedSubnavItem = 'keys' %}

{% block actionButton %}
    <a class="btn submit add icon" href="{{ url('typesense/keys/new') }}">{{ 'Create a key'|t('typesense') }}</a>
{% endblock %}

{% block content %}
    <p class="light">{{ 'Create and manage Typesense API keys. The full key value is shown only once, at creation, and is never stored by the plugin.'|t('typesense') }}</p>

    {% if keys is empty %}
        <div class="zilch"><p>{{ 'No API keys on the server yet.'|t('typesense') }}</p></div>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Description'|t('typesense') }}</th>
                    <th scope="col">{{ 'Prefix'|t('typesense') }}</th>
                    <th scope="col">{{ 'Permissions'|t('typesense') }}</th>
                    <th scope="col">{{ 'Collections'|t('typesense') }}</th>
                    <th scope="col">{{ 'Expires'|t('typesense') }}</th>
                    <th scope="col"><span class="visually-hidden">{{ 'Actions'|t('typesense') }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for key in keys %}
                    <tr>
                        <td>{{ key.description ?? '' }}</td>
                        <td><code>{{ key.value_prefix ?? '' }}...</code></td>
                        <td>{% for action in key.actions ?? [] %}<code>{{ action }}</code>{{ not loop.last ? ' ' }}{% endfor %}</td>
                        <td>{% for c in key.collections ?? [] %}<code>{{ c }}</code>{{ not loop.last ? ' ' }}{% endfor %}</td>
                        <td>{{ key.expires_at is defined and key.expires_at < 64000000000 ? key.expires_at|date('short') : 'Never'|t('typesense') }}</td>
                        <td class="nowrap thin" data-title="{{ 'Actions'|t('typesense') }}">
                            {{ disclosureMenu([
                                {
                                    label: 'Rotate'|t('typesense'),
                                    url: url('typesense/keys/new', { from: key.id }),
                                },
                                {
                                    label: 'Delete'|t('typesense'),
                                    action: 'typesense/keys/delete-key',
                                    params: { id: key.id },
                                    destructive: true,
                                    confirm: 'Delete this key? Any client using it will stop working immediately.'|t('typesense'),
                                },
                            ], {
                                buttonAttributes: {
                                    class: ['action-btn', 'hairline'],
                                    hiddenLabel: 'Actions'|t('typesense'),
                                },
                            }) }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <hr>

    <h2>{{ 'Scoped-key profiles'|t('typesense') }}</h2>
    <p class="light">{{ 'A scoped-key profile is a reusable filter template for front-end scoped search keys. Reference one in Twig with craft.typesense.scopedSearchKey({ profile: "handle" }) to issue a narrow, expiring key that only ever sees the filtered results.'|t('typesense') }}</p>

    {% if profiles is empty %}
        <div class="zilch"><p>{{ 'No profiles yet.'|t('typesense') }}</p></div>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Profile'|t('typesense') }}</th>
                    <th scope="col">{{ 'Handle'|t('typesense') }}</th>
                    <th scope="col">{{ 'Filter'|t('typesense') }}</th>
                    <th scope="col">{{ 'Expires in'|t('typesense') }}</th>
                    <th scope="col"><span class="visually-hidden">{{ 'Actions'|t('typesense') }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for handle, profile in profiles %}
                    <tr>
                        <td><a href="{{ url('typesense/keys/profile/' ~ handle) }}"><strong>{{ profile.name }}</strong></a></td>
                        <td><code>{{ handle }}</code></td>
                        <td>{% if profile.filterBy %}<code>{{ profile.filterBy }}</code>{% else %}<span class="light">{{ 'None'|t('typesense') }}</span>{% endif %}</td>
                        <td>{{ profile.expiresIn > 0 ? profile.expiresIn ~ 's' : 'Never'|t('typesense') }}</td>
                        <td class="nowrap thin" data-title="{{ 'Actions'|t('typesense') }}">
                            {{ disclosureMenu([
                                {
                                    label: 'Delete'|t('typesense'),
                                    action: 'typesense/keys/delete-profile',
                                    params: { id: handle },
                                    destructive: true,
                                    confirm: 'Delete this profile?'|t('typesense'),
                                },
                            ], {
                                buttonAttributes: {
                                    class: ['action-btn', 'hairline'],
                                    hiddenLabel: 'Actions'|t('typesense'),
                                },
                            }) }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <div class="buttons">
        <a class="btn submit add icon" href="{{ url('typesense/keys/profile') }}">{{ 'New profile'|t('typesense') }}</a>
    </div>
{% endblock %}

{%- requirePermission 'typesense:plugin-settings' -%}

{%- extends "_layouts/cp" -%}

{%- import '_includes/forms' as forms -%}
{% from 'typesense/_macros' import instructions %}

{%- do view.registerAssetBundle('percipiolondon\\typesense\\assetbundles\\typesense\\TypesenseAsset') -%}

{% set tabs = {
    server: {label: "Server"|t('typesense'), url: "#server"},
    api: {label: "API"|t('typesense'), url: "#api"},
    synonyms: {label: "Synonyms"|t('typesense'), url: "#synonyms"},
} %}

{%- block content -%}

    <input type="hidden" name="action" value="typesense/settings/save-plugin-settings">
    <input type="hidden" name="pluginHandle" value="typesense">

    {{- redirectInput('typesense/plugin') -}}

    <div id="server">
        {{ forms.selectField({
            label: 'Typesense Server Type'|t('typesense'),
            instructions: 'The server type for connecting to the Typesense API.'|t('typesense'),
            suggestEnvVars: true,
            name: 'serverType',
            value: settings.serverType,
            options: {
                'server': "Single Server"|t('typesense'),
                'cluster': "Cluster"|t('typesense')
            },
            toggle: true,
            required: true,
        }) }}

        <div id="server" class="hidden">
            {{ forms.autosuggestField({
                label: 'Typesense host address',
                instructions: 'The Typesense server address.'|t('typesense'),
                suggestEnvVars: true,
                id: 'server',
                name: 'server',
                value: settings.server,
            }) }}

            {{ forms.autosuggestField({
                label: 'Typesense port ( default is 8108 )',
                instructions: 'Port on which Typesense API service listens.'|t('typesense'),
                suggestEnvVars: true,
                id: 'port',
                name: 'port',
                value: settings.port,
            }) }}
        </div>

        <div id="cluster" class="hidden">
            {{ forms.autosuggestField({
                label: 'Typesense cluster servers',
                instructions: 'The Typesense cluster server addresses divided by `;`.'|t('typesense'),
                suggestEnvVars: true,
                id: 'cluster',
                name: 'cluster',
                value: settings.cluster,
            }) }}

            {{ forms.autosuggestField({
                label: 'Typesense load-balanced endpoint',
                instructions: 'The Typesense nearest node.'|t('typesense'),
                suggestEnvVars: true,
                id: 'nearestNode',
                name: 'nearestNode',
                value: settings.nearestNode,
            }) }}

            {{ forms.autosuggestField({
                label: 'Typesense cluster port ( default is 8108 )',
                instructions: 'Port on which the Typesense API service listens.'|t('typesense'),
                suggestEnvVars: true,
                id: 'clusterPort',
                name: 'clusterPort',
                value: settings.clusterPort,
            }) }}
        </div>

        {{ forms.autosuggestField({
            label: 'Protocol ( default is http )',
            instructions: 'Protocol on which the Typesense API service is accessed.'|t('typesense'),
            suggestEnvVars: true,
            id: 'protocol',
            name: 'protocol',
            value: settings.protocol,
        }) }}
    </div>

    <div id="api" class="hidden">
        {{ forms.autosuggestField({
            label: 'API Key',
            instructions: 'The admin API key that allows all operations.'|t('typesense'),
            suggestEnvVars: true,
            required: true,
            id: 'apiKey',
            name: 'apiKey',
            value: settings.apiKey,
        }) }}

        {{ forms.autosuggestField({
            label: 'Search only API Key',
            instructions: 'The search only API key that can fetch the search results only.'|t('typesense'),
            suggestEnvVars: true,
            id: 'searchOnlyApiKey',
            name: 'searchOnlyApiKey',
            value: settings.searchOnlyApiKey,
        }) }}
    </div>

    <div id="synonyms" class="hidden">
        {%- set info -%}
            <b>{{- 'Typesense supports two types of synonyms:'|t('typsense') -}}</b>
            <ol style="max-width:500px;">
                <li>
                    {{- 'One-way synonyms: Defining the words iphone and android as one-way synonyms of smart phone will cause searches for smart phone to return documents containing iphone or android or both.'|t('typsense') -}}
                </li>
                <li>
                    {{- 'Multi-way synonyms: Defining the words blazer, coat and jacket as multi-way synonyms will cause searches for any one of those words (eg: coat) to return documents containing at least one of the words in the synonym set (eg: records with blazer or coat or jacket are returned).'|t('typesense') -}}
                </li>
            </ol>
        {%- endset -%}
        {{ forms.selectField({
            label: "Direction of the synonyms"|t('typesense'),
            instructions: instructions("Whether to go one-way or multi-way sync for the synonyms", info),
            name: 'synonymsDirection',
            value: settings.synonymsDirection,
            options: {
                'one-way': 'One-way'|t('typesense'),
                'multi-way': 'Multi-way'|t('typesense'),
            },
            required: true,
        }) }}

    </div>

{%- endblock -%}

{# =========================================================================
   Typesense Pro - aliases manager (one coherent flow)
   =========================================================================
   One table of collections: the query name a front end should hit (copyable),
   the physical target currently serving it (copyable), and when it was last
   built, with a per-row zero-downtime rebuild (the core per-row action-menu
   idiom from vendor/craftcms/cms/src/templates/settings/plugins/index.twig, via
   the disclosureMenu Twig function). The copyable chips use Craft's copy-text
   button, the same control behind a VueAdminTable handle column. A
   capability-gated clone folds in below.

   @var rows            array   {name, resolved, physical, aliased, lastBuilt}
   @var supportsCloning bool
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% import '_includes/forms.twig' as forms %}
{% set title = 'Aliases'|t('typesense') %}
{% set selectedSubnavItem = 'aliases' %}

{% block content %}
    <div class="readable">
        <p class="light">{{ 'An alias gives your front end a stable collection name while a rebuild swaps the physical collection behind it atomically. Search keeps serving the current collection until the new one is built and ready, so there is no downtime and no empty window. Rebuild a collection whenever its schema or mapping changed and you want a clean reindex.'|t('typesense') }}</p>
    </div>

    {% if rows is empty %}
        <div class="zilch"><p>{{ 'No collections are declared yet.'|t('typesense') }}</p></div>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Collection'|t('typesense') }}</th>
                    <th scope="col">{{ 'Query name'|t('typesense') }}</th>
                    <th scope="col">{{ 'Serving collection'|t('typesense') }}</th>
                    <th scope="col">{{ 'Last built'|t('typesense') }}</th>
                    <th scope="col"><span class="visually-hidden">{{ 'Actions'|t('typesense') }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td><strong>{{ row.name }}</strong></td>
                        <td><span class="ts-copytext" data-value="{{ row.resolved }}"></span></td>
                        <td>
                            <span class="ts-copytext" data-value="{{ row.physical }}"></span>
                            {% if not row.aliased %}<span class="light"> {{ '(direct, not aliased yet)'|t('typesense') }}</span>{% endif %}
                        </td>
                        <td>
                            {% if row.lastBuilt %}
                                {{ row.lastBuilt|date('short') }} {{ row.lastBuilt|time('short') }}
                            {% else %}
                                <span class="light">{{ 'Unknown'|t('typesense') }}</span>
                            {% endif %}
                        </td>
                        <td class="nowrap thin" data-title="{{ 'Actions'|t('typesense') }}">
                            {{ disclosureMenu([
                                {
                                    label: 'Rebuild (zero-downtime)'|t('typesense'),
                                    action: 'typesense/aliases/rebuild',
                                    params: { collection: row.name },
                                    confirm: 'Queue a zero-downtime rebuild of {name}? The alias keeps serving the current collection until the swap.'|t('typesense', { name: row.name }),
                                },
                            ], {
                                buttonAttributes: {
                                    class: ['action-btn', 'hairline'],
                                    hiddenLabel: 'Actions'|t('typesense'),
                                },
                            }) }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% js %}
            // Render Craft's copy-text button into each query/physical name cell
            // (the same control a VueAdminTable handle column uses).
            $('.ts-copytext').each(function() {
                var value = $(this).data('value');
                if (value) {
                    $(this).append(Craft.ui.createCopyTextBtn({ value: value, class: 'code light' }));
                }
            });
        {% endjs %}
    {% endif %}

    {% if supportsCloning %}
        <hr>
        <h2>{{ 'Clone a collection'|t('typesense') }}</h2>
        <p class="light">{{ 'Copies a collection’s schema (not its documents) into a new, separately named collection. Useful for trialling a schema change off to the side.'|t('typesense') }}</p>
        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('typesense/aliases/clone') }}
            {{ redirectInput('typesense/aliases') }}
            {{ forms.textField({ label: 'Source collection'|t('typesense'), name: 'source', required: true }) }}
            {{ forms.textField({ label: 'New collection name'|t('typesense'), name: 'target', required: true }) }}
            <div class="buttons"><button type="submit" class="btn submit">{{ 'Clone'|t('typesense') }}</button></div>
        </form>
    {% endif %}
{% endblock %}

{# =========================================================================
   Typesense Pro - dictionaries manager (stopwords for a collection)
   =========================================================================
   @var handle    string
   @var stopwords array
   @var locale    string
   @var editable  bool   whether this collection's stopwords are CP-managed
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% import '_includes/forms.twig' as forms %}
{% set title = handle ~ ' ' ~ ('stopwords'|t('typesense')) %}
{% set selectedSubnavItem = 'dictionaries' %}
{% set fullPageForm = editable %}
{% set crumbs = [{ label: 'Dictionaries'|t('typesense'), url: url('typesense/dictionaries') }] %}

{% block content %}
    {% if not editable %}
        <blockquote class="note">
            {{ 'This collection declares its stopwords in config. They are read-only here.'|t('typesense') }}
        </blockquote>

        <p><strong>{{ 'Stopwords'|t('typesense') }}:</strong></p>
        {% if stopwords is empty %}
            <p class="light">{{ 'None.'|t('typesense') }}</p>
        {% else %}
            <p>{% for word in stopwords %}<code>{{ word }}</code>{{ not loop.last ? ' ' }}{% endfor %}</p>
        {% endif %}
    {% else %}
        {{ actionInput('typesense/dictionaries/save-stopwords') }}
        {{ hiddenInput('collection', handle) }}

        {{ forms.editableTableField({
            first: true,
            label: 'Stopwords'|t('typesense'),
            instructions: 'Words dropped from a search query against this collection before matching.'|t('typesense')
                ~ '<span class="info">'
                ~ 'Stopwords are removed from the query at search time, not during indexing, so the documents keep every word. Forwarded to Typesense as the '
                ~ '<code>stopwords</code> search parameter.'|t('typesense')
                ~ '</span>',
            id: 'stopwords',
            name: 'stopwords',
            cols: {
                word: { heading: 'Word'|t('typesense'), type: 'singleline' },
            },
            rows: stopwords|map(word => { word: word }),
            addRowLabel: 'Add a word'|t('typesense'),
        }) }}

        {{ forms.languageMenuField({
            label: 'Locale'|t('typesense'),
            instructions: 'Optional language for stopword matching.'|t('typesense')
                ~ '<span class="info">'
                ~ 'Typesense scopes a stopword set to an ISO language code (for example en, nl). The region is dropped on save, so en-GB is stored as en.'|t('typesense')
                ~ '</span>',
            id: 'locale',
            name: 'locale',
            value: locale,
        }) }}
    {% endif %}
{% endblock %}

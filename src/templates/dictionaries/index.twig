{# =========================================================================
   Typesense Pro - dictionaries manager (stopwords collection picker)
   =========================================================================
   @var collections array
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% set title = 'Dictionaries'|t('typesense') %}
{% set selectedSubnavItem = 'dictionaries' %}

{% block content %}
    <p class="light">{{ 'Manage each collection’s stopwords, and the stemming dictionaries shared across collections.'|t('typesense') }}</p>

    <p><a class="btn" href="{{ url('typesense/dictionaries/stemming') }}">{{ 'Stemming dictionaries'|t('typesense') }}</a></p>

    <h2>{{ 'Stopwords'|t('typesense') }}</h2>

    {% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}
    <div id="ts-stopwords-table"></div>

    {% set tableData = [] %}
    {% for handle in collections %}
        {% set tableData = tableData|merge([{
            title: handle,
            url: url('typesense/dictionaries/' ~ handle),
        }]) %}
    {% endfor %}

    {% js %}
        new Craft.VueAdminTable({
            columns: [
                { name: '__slot:title', title: Craft.t('typesense', 'Collection') },
            ],
            container: '#ts-stopwords-table',
            emptyMessage: Craft.t('typesense', 'No collections are declared yet.'),
            tableData: {{ tableData|json_encode(constant('JSON_HEX_TAG'))|raw }},
        });
    {% endjs %}
{% endblock %}

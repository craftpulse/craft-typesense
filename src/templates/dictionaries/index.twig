{# =========================================================================
   Typesense Pro - dictionaries manager (stopwords collection picker)
   =========================================================================
   @var collections array
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% set title = 'Dictionaries'|t('typesense') %}
{% set selectedSubnavItem = 'dictionaries' %}

{# The table is the sole content of its pane (a VueAdminTable bleeds to the pane
   edges, so any copy or heading above it is clipped). The intro rides
   contentNotice, and the Stemming dictionaries link rides the header action
   button, matching how core index screens keep copy and buttons out of the
   table's pane (settings/assets/transforms/_index.twig, settings/fields/index). #}
{% set contentNotice = 'Manage each collection’s stopwords below. Stemming dictionaries are shared across collections.'|t('typesense') %}

{% block actionButton %}
    <a class="btn" href="{{ url('typesense/dictionaries/stemming') }}">{{ 'Stemming dictionaries'|t('typesense') }}</a>
{% endblock %}

{% block content %}
    {% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}
    <div id="ts-stopwords-table"></div>

    {% set tableData = [] %}
    {% for handle in collections %}
        {% set tableData = tableData|merge([{
            title: handle,
            url: url('typesense/dictionaries/' ~ handle),
        }]) %}
    {% endfor %}

    {% js %}
        new Craft.VueAdminTable({
            columns: [
                { name: '__slot:title', title: Craft.t('typesense', 'Collection') },
            ],
            container: '#ts-stopwords-table',
            emptyMessage: Craft.t('typesense', 'No collections are declared yet.'),
            tableData: {{ tableData|json_encode(constant('JSON_HEX_TAG'))|raw }},
        });
    {% endjs %}
{% endblock %}

{# @var status array #}
{# @var collections array #}
{# @var suspended bool #}
{# @var canManage bool #}
{# @var ops array #}
{# @var canRunOps bool #}
{% import '_includes/forms.twig' as forms %}

<h2>{{ 'Server status'|t('typesense') }}</h2>
{% if not status.configured %}
    <p>{{ 'Typesense is not configured. Add an admin API key in the plugin settings.'|t('typesense') }}</p>
{% elseif not status.connected %}
    <p><span class="status red"></span> {{ 'Not connected.'|t('typesense') }}</p>
{% else %}
    <p>
        <span class="status green"></span>
        {{ 'Connected to Typesense {version}.'|t('typesense', { version: status.version ?? '?' }) }}
    </p>
    {% if not status.supported and status.unsupportedReason %}
        <blockquote class="note warning">{{ status.unsupportedReason }}</blockquote>
    {% else %}
        <p>{{ 'Available features:'|t('typesense') }}</p>
        <ul>
            {% for flag, enabled in status.flags %}
                {% if enabled %}<li><code>{{ flag }}</code></li>{% endif %}
            {% endfor %}
        </ul>
    {% endif %}
{% endif %}

<hr>

<h2>{{ 'Collections'|t('typesense') }}</h2>
{% if collections is empty %}
    <p>{{ 'No collections are declared.'|t('typesense') }}</p>
{% else %}
    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ 'Collection'|t('typesense') }}</th>
                <th>{{ 'Target'|t('typesense') }}</th>
                <th>{{ 'Strategy'|t('typesense') }}</th>
                <th>{{ 'Documents'|t('typesense') }}</th>
                <th>{{ 'Drift'|t('typesense') }}</th>
                <th>{{ 'Sync'|t('typesense') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for row in collections %}
                <tr>
                    <td>{{ row.name }}</td>
                    <td><code>{{ row.target }}</code></td>
                    <td>{{ row.strategy }}</td>
                    <td>{{ row.documents is null ? '?' : row.documents }}</td>
                    <td>
                        {% if row.drift == 'inSync' %}
                            <span class="status green"></span> {{ 'In sync'|t('typesense') }}
                        {% elseif row.drift == 'drifted' %}
                            <span class="status orange"></span> {{ 'Drifted'|t('typesense') }}
                        {% else %}
                            <span class="status red"></span> {{ 'Missing'|t('typesense') }}
                        {% endif %}
                    </td>
                    <td class="thin">
                        {% if suspended %}
                            <span class="status" title="{{ 'Globally suspended'|t('typesense') }}"></span> {{ 'Suspended (global)'|t('typesense') }}
                        {% elseif row.suspended %}
                            <span class="status orange"></span> {{ 'Suspended'|t('typesense') }}
                        {% else %}
                            <span class="status green"></span> {{ 'Active'|t('typesense') }}
                        {% endif %}

                        {% if canManage and not suspended %}
                            <form method="post" accept-charset="UTF-8" style="display:inline">
                                {{ csrfInput() }}
                                {{ actionInput('typesense/utility/toggle-suspend') }}
                                {{ hiddenInput('collection', row.name) }}
                                {{ redirectInput('utilities/typesense') }}
                                <button type="submit" class="btn small">{{ row.suspended ? 'Resume'|t('typesense') : 'Suspend'|t('typesense') }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <p class="light">{{ 'Run `craft typesense/config/diff` for the full drift report.'|t('typesense') }}</p>
{% endif %}

{% if ops is not empty %}
    <hr>
    <h2>{{ 'Server operations'|t('typesense') }}</h2>
    <table class="data fullwidth">
        <tbody>
            <tr>
                <th>{{ 'Memory used'|t('typesense') }}</th>
                <td>{{ (ops.memoryUsedBytes / 1024 / 1024)|number_format(1) }} MB {% if ops.memoryTotalBytes %}/ {{ (ops.memoryTotalBytes / 1024 / 1024)|number_format(1) }} MB{% endif %}</td>
            </tr>
            <tr>
                <th>{{ 'Disk used'|t('typesense') }}</th>
                <td>{{ (ops.diskUsedBytes / 1024 / 1024)|number_format(1) }} MB {% if ops.diskTotalBytes %}/ {{ (ops.diskTotalBytes / 1024 / 1024)|number_format(1) }} MB{% endif %}</td>
            </tr>
            {% if ops.cpuActivePercentage %}
                <tr>
                    <th>{{ 'CPU active'|t('typesense') }}</th>
                    <td>{{ ops.cpuActivePercentage }}%</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    {% if canRunOps %}
        <div class="buttons">
            <form method="post" accept-charset="UTF-8" data-confirm="{{ 'Compact the database now?'|t('typesense') }}">
                {{ csrfInput() }}
                {{ actionInput('typesense/ops/compact') }}
                {{ redirectInput('utilities/typesense') }}
                <button type="submit" class="btn">{{ 'Compact database'|t('typesense') }}</button>
            </form>
            <form method="post" accept-charset="UTF-8" data-confirm="{{ 'Clear the query cache?'|t('typesense') }}">
                {{ csrfInput() }}
                {{ actionInput('typesense/ops/clear-cache') }}
                {{ redirectInput('utilities/typesense') }}
                <button type="submit" class="btn">{{ 'Clear cache'|t('typesense') }}</button>
            </form>
        </div>
        <form method="post" accept-charset="UTF-8" class="ts-ops-snapshot">
            {{ csrfInput() }}
            {{ actionInput('typesense/ops/snapshot') }}
            {{ redirectInput('utilities/typesense') }}
            {{ forms.textField({
                label: 'Snapshot to server path'|t('typesense'),
                instructions: 'An absolute path on the Typesense server the snapshot is written to.'|t('typesense'),
                name: 'snapshotPath',
                placeholder: '/data/snapshots/manual',
            }) }}
            <button type="submit" class="btn">{{ 'Take snapshot'|t('typesense') }}</button>
        </form>
    {% endif %}
{% endif %}

{% if canManage %}
    <hr>
    <h2>{{ 'Actions'|t('typesense') }}</h2>
    <div class="buttons">
        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('typesense/utility/sync') }}
            {{ redirectInput('utilities/typesense') }}
            <button type="submit" class="btn submit">{{ 'Sync all'|t('typesense') }}</button>
        </form>
        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('typesense/utility/flush') }}
            {{ redirectInput('utilities/typesense') }}
            <button type="submit" class="btn">{{ 'Flush all'|t('typesense') }}</button>
        </form>
        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('typesense/utility/toggle-suspend') }}
            {{ redirectInput('utilities/typesense') }}
            <button type="submit" class="btn">
                {{ suspended ? 'Resume sync'|t('typesense') : 'Suspend sync'|t('typesense') }}
            </button>
        </form>
    </div>
    {% if suspended %}
        <p><span class="status orange"></span> {{ 'Sync is currently suspended.'|t('typesense') }}</p>
    {% endif %}
{% endif %}

{
    "name": "craftpulse/craft-typesense",
    "description": "Craft Plugin that synchronises with Typesense",
    "type": "craft-plugin",
    "version": "5.9.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "typesense"
    ],
    "support": {
        "email": "support@craft-pulse.com",
        "docs": "https://github.com/craftpulse/craft-typesense/blob/master/README.md",
        "issues": "https://github.com/craftpulse/craft-typesense/issues",
        "source": "https://github.com/craftpulse/craft-typesense"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "CraftPulse",
            "homepage": "https://craft-pulse.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.0.2",
        "craftcms/cms": "^5.0.0",
        "illuminate/collections": "^v10.42.0",
        "typesense/typesense-php": "^4.7.0",
        "php-http/guzzle7-adapter": "^1.0.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "markhuot/craft-pest-core": "^3.2",
        "nystudio107/craft-plugin-vite": "^5.0.0",
        "vlucas/phpdotenv": "^5.4.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "craftpulse\\typesense\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "craftpulse\\typesense\\tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan --ansi --memory-limit=1G",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --fix --ansi"
    },
    "extra": {
        "name": "Typesense",
        "handle": "typesense",
        "developer": "craftpulse",
        "developerUrl": "https://craft-pulse.com",
        "documentationUrl": "https://github.com/craftpulse/craft-typesense/blob/v5/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/craftpulse/craft-typesense/v5/CHANGELOG.md",
        "components": {
            "typesenseService": "craftpulse\\typesense\\services\\TypesenseService"
        },
        "class": "craftpulse\\typesense\\Typesense"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true,
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    }
}

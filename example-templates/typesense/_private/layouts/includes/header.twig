<header class="w-full border-b border-gray-200 bg-white">
    <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between" aria-label="{{ 'Typesense demos'|t('typesense') }}">
        <a class="font-semibold text-gray-900 hover:underline" href="{{ url('typesense/search') }}">{{ siteName }}</a>

        <ul class="flex items-center space-x-4 text-sm">
            <li><a class="text-gray-600 hover:text-gray-900 hover:underline" href="{{ url('typesense/search') }}">{{ 'Search'|t('typesense') }}</a></li>
            <li><a class="text-gray-600 hover:text-gray-900 hover:underline" href="{{ url('typesense/autocomplete') }}">{{ 'Autocomplete'|t('typesense') }}</a></li>
            <li><a class="text-gray-600 hover:text-gray-900 hover:underline" href="{{ url('typesense/geo') }}">{{ 'Geo'|t('typesense') }}</a></li>
            <li><a class="text-gray-600 hover:text-gray-900 hover:underline" href="{{ url('typesense/voice') }}">{{ 'Voice'|t('typesense') }}</a></li>
            <li><a class="text-gray-600 hover:text-gray-900 hover:underline" href="{{ url('typesense/ask') }}">{{ 'Ask'|t('typesense') }}</a></li>
        </ul>
    </nav>
</header>
